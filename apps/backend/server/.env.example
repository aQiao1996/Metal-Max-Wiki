APP_NAME=Metal Max Wiki API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://metalmax:metalmax@localhost:5432/metalmax
CLIENT_ORIGIN=http://localhost:3000
SESSION_DAYS=7
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_PROVIDER=openai-compatible
AI_MODEL=your-installed-model
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_CONTEXT_CHARS=4000
AI_MAX_EVIDENCE_CHUNKS=12
# 原生 Ollama 可显式设 AI_PROVIDER=ollama，按每次请求设置上下文窗口。
AI_OLLAMA_CONTEXT_TOKENS=16384
