# 复制为同目录 .env，限制为 600 权限后填写；本文件不代表 DNS 或 HTTPS 已就绪。
SITE_DOMAIN=wiki.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=metalmax
POSTGRES_DB=metalmax
# 必填；使用 openssl rand -hex 32 生成，避免数据库 URL 中的保留字符。
POSTGRES_PASSWORD=

# 必填；填写可从 API 容器访问的私有模型网关或在线兼容接口，并保留 /v1。
# 本机 Ollama 需先经私有网络或经确认配置的 SSH 反向隧道接入；不要公开 11434 端口。
AI_BASE_URL=
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_CONTEXT_CHARS=4000
AI_MAX_EVIDENCE_CHUNKS=12
# 选择 ollama 时按请求固定上下文窗口，云服务器不运行模型进程。
AI_OLLAMA_CONTEXT_TOKENS=16384
